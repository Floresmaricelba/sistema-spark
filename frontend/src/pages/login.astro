---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/layout/Logo.astro';
---
<BaseLayout title="Spark Fit Center | Iniciar sesión">
  <main class="grid min-h-screen bg-gym-black text-white lg:grid-cols-2"><section class="hidden bg-neutral-900 lg:block"><img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&w=1200&q=85" alt="Entrenamiento en Spark Fit Center" class="h-full w-full object-cover opacity-80" /></section><section class="flex items-center justify-center px-6 py-12"><div class="w-full max-w-md"><div class="mb-16"><Logo dark /></div><p class="font-bold tracking-[.2em] text-gym-red">ADMINISTRADOR</p><h1 class="mt-3 font-display text-7xl tracking-wide">Iniciar sesión</h1><p class="mt-4 text-sm leading-6 text-neutral-400">Accede al panel de administración para gestionar clientes y registros.</p><form id="login-form" class="mt-10 space-y-5" novalidate><label class="block"><span class="mb-2 block text-xs font-bold text-neutral-300">Usuario</span><input name="nombreUsuario" autocomplete="username" required class="focus-ring w-full border border-neutral-600 bg-neutral-900 px-4 py-4 text-sm outline-none focus:border-gym-red" placeholder="Usuario administrador" /></label><label class="block"><span class="mb-2 block text-xs font-bold text-neutral-300">Contraseña</span><input name="contrasena" type="password" autocomplete="current-password" required class="focus-ring w-full border border-neutral-600 bg-neutral-900 px-4 py-4 text-sm outline-none focus:border-gym-red" placeholder="Contraseña" /></label><p id="login-error" class="hidden text-sm text-red-400" role="alert"></p><button class="w-full bg-gym-red px-5 py-4 text-sm font-bold transition hover:bg-red-700 disabled:cursor-wait disabled:opacity-60" type="submit">Entrar</button></form><a href="/" class="mt-8 inline-block text-sm text-neutral-500 hover:text-white">← Volver al inicio</a></div></section></main>
  <script>
    import { loginSchema } from '../schemas/auth.schema';
    import { login } from '../lib/api';
    import { saveSession } from '../lib/auth';
    const form = document.querySelector<HTMLFormElement>('#login-form');
    const error = document.querySelector<HTMLElement>('#login-error');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form || !error) return;
      const button = form.querySelector<HTMLButtonElement>('button');
      const input = Object.fromEntries(new FormData(form).entries());
      const result = loginSchema.safeParse(input);
      if (!result.success) { error.textContent = result.error.issues[0]?.message ?? 'Revisa los datos'; error.classList.remove('hidden'); return; }
      error.classList.add('hidden'); if (button) button.disabled = true;
      try { saveSession(await login(result.data)); window.location.assign('/dashboard/clientes'); }
      catch (requestError) { error.textContent = requestError instanceof Error ? requestError.message : 'No fue posible iniciar sesión'; error.classList.remove('hidden'); if (button) button.disabled = false; }
    });
  </script>
</BaseLayout>
