---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
  <BaseLayout title="Spark Fit Center | Clientes">
  <main class="min-h-screen bg-gym-paper text-gym-black"><header class="border-b border-neutral-200 bg-white px-6 py-5"><div class="mx-auto flex max-w-7xl items-center justify-between"><a href="/" class="text-xl font-extrabold">SPARK FIT</a><div class="flex items-center gap-4"><span id="user-name" class="hidden text-sm font-bold sm:inline"></span><button id="logout" class="bg-gym-red px-4 py-2 text-xs font-bold text-white hover:bg-red-700">Cerrar sesión</button></div></div></header><section class="mx-auto max-w-7xl px-6 py-12"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="text-xs font-extrabold tracking-[.2em] text-gym-red">ADMINISTRACIÓN</p><h1 class="mt-2 font-display text-7xl tracking-wide">Clientes</h1><p class="mt-2 text-sm text-neutral-500">Gestiona los registros del gimnasio.</p></div><button id="new-client" class="bg-gym-red px-5 py-3 text-sm font-bold text-white hover:bg-red-700">+ Nuevo cliente</button></div><form id="filters" class="mt-10 grid gap-3 rounded bg-white p-5 shadow-sm sm:grid-cols-2 lg:grid-cols-6"><input name="nombreCliente" placeholder="Buscar por nombre" class="border border-neutral-200 px-3 py-3 text-sm outline-none focus:border-gym-red" /><input name="telefono" placeholder="Teléfono" maxlength="8" class="border border-neutral-200 px-3 py-3 text-sm outline-none focus:border-gym-red" /><select name="tipoEntrada" class="border border-neutral-200 px-3 py-3 text-sm outline-none focus:border-gym-red"><option value="">Entrada</option><option value="mensual">Mensual</option><option value="semanal">Semanal</option><option value="sesión">Sesión</option></select><select name="tipoPago" class="border border-neutral-200 px-3 py-3 text-sm outline-none focus:border-gym-red"><option value="">Pago</option><option value="efectivo">Efectivo</option><option value="QR">QR</option></select><input name="fechaDesde" type="date" class="border border-neutral-200 px-3 py-3 text-sm outline-none focus:border-gym-red" /><input name="fechaHasta" type="date" class="border border-neutral-200 px-3 py-3 text-sm outline-none focus:border-gym-red" /><button class="bg-gym-black px-4 py-3 text-sm font-bold text-white hover:bg-neutral-700 sm:col-span-2 lg:col-span-6 lg:justify-self-end" type="submit">Aplicar filtros</button></form><p id="feedback" class="mt-5 hidden text-sm" role="status"></p><div class="mt-5 overflow-x-auto bg-white shadow-sm"><table class="w-full min-w-[760px] text-left text-sm"><thead class="bg-gym-black text-xs uppercase tracking-wider text-white"><tr><th class="px-5 py-4">Cliente</th><th class="px-5 py-4">Teléfono</th><th class="px-5 py-4">Entrada</th><th class="px-5 py-4">Pago</th><th class="px-5 py-4">Monto</th><th class="px-5 py-4">Registro</th><th class="px-5 py-4">Acción</th></tr></thead><tbody id="client-rows"><tr><td colspan="7" class="px-5 py-10 text-center text-neutral-500">Cargando clientes...</td></tr></tbody></table></div></section><dialog id="client-dialog" class="m-auto w-[calc(100%-2rem)] max-w-xl border-0 bg-white p-0 shadow-2xl backdrop:bg-black/70"><form id="client-form" class="p-7" method="dialog"><div class="flex items-center justify-between"><h2 id="dialog-title" class="font-display text-4xl">Nuevo cliente</h2><button type="button" id="close-dialog" class="text-2xl">×</button></div><input type="hidden" name="idCliente" /><div class="mt-6 grid gap-4 sm:grid-cols-2"><label class="sm:col-span-2"><span class="mb-1 block text-xs font-bold">Nombre completo</span><input name="nombreCliente" required class="w-full border border-neutral-300 px-3 py-3 text-sm" /></label><label><span class="mb-1 block text-xs font-bold">Teléfono</span><input name="telefono" required maxlength="8" class="w-full border border-neutral-300 px-3 py-3 text-sm" /></label><label><span class="mb-1 block text-xs font-bold">Monto (Bs)</span><input name="montoPago" type="number" min="0" max="10000" step="0.01" required class="w-full border border-neutral-300 px-3 py-3 text-sm" /></label><label><span class="mb-1 block text-xs font-bold">Tipo de entrada</span><select name="tipoEntrada" class="w-full border border-neutral-300 px-3 py-3 text-sm"><option value="mensual">Mensual</option><option value="semanal">Semanal</option><option value="sesión">Sesión</option></select></label><label><span class="mb-1 block text-xs font-bold">Tipo de pago</span><select name="tipoPago" class="w-full border border-neutral-300 px-3 py-3 text-sm"><option value="efectivo">Efectivo</option><option value="QR">QR</option></select></label></div><p id="form-error" class="mt-4 hidden text-sm text-red-600"></p><button class="mt-6 w-full bg-gym-red px-5 py-3 text-sm font-bold text-white hover:bg-red-700" type="submit">Guardar cliente</button></form></dialog></main>
  <script>
    import { clienteFiltersSchema, clienteSchema } from '../../schemas/cliente.schema';
    import { createCliente, listClientes, logout, updateCliente } from '../../lib/api';
    import { getUser, requireSession } from '../../lib/auth';
    requireSession();
    const rows = document.querySelector<HTMLElement>('#client-rows'); const feedback = document.querySelector<HTMLElement>('#feedback'); const filters = document.querySelector<HTMLFormElement>('#filters'); const dialog = document.querySelector<HTMLDialogElement>('#client-dialog'); const form = document.querySelector<HTMLFormElement>('#client-form'); const formError = document.querySelector<HTMLElement>('#form-error'); const userName = document.querySelector<HTMLElement>('#user-name');
    const money = new Intl.NumberFormat('es-BO', { style: 'currency', currency: 'BOB' });
    let editingId: number | undefined;
    if (userName) userName.textContent = getUser()?.nombreUsuario ?? '';
    const showFeedback = (message: string, danger = false) => { if (!feedback) return; feedback.textContent = message; feedback.className = `mt-5 text-sm ${danger ? 'text-red-600' : 'text-green-700'}`; };
    const render = (items: Awaited<ReturnType<typeof listClientes>>) => { if (!rows) return; if (!items.length) { rows.innerHTML = '<tr><td colspan="7" class="px-5 py-10 text-center text-neutral-500">No hay clientes para mostrar.</td></tr>'; return; } rows.innerHTML = items.map((client) => `<tr class="border-b border-neutral-100"><td class="px-5 py-4 font-bold">${escapeHtml(client.nombreCliente)}</td><td class="px-5 py-4">${client.telefono}</td><td class="px-5 py-4 capitalize">${client.tipoEntrada}</td><td class="px-5 py-4">${client.tipoPago}</td><td class="px-5 py-4">${money.format(client.montoPago)}</td><td class="px-5 py-4">${client.fechaRegistro ? new Date(client.fechaRegistro).toLocaleDateString('es-BO') : '—'}</td><td class="px-5 py-4"><button data-edit="${client.idCliente}" class="font-bold text-gym-red hover:underline">Editar</button></td></tr>`).join(''); rows.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((button) => button.addEventListener('click', () => { const client = items.find((item) => item.idCliente === Number(button.dataset.edit)); if (client) openEdit(client); })); };
    const load = async () => { try { const parsed = clienteFiltersSchema.parse(Object.fromEntries(new FormData(filters!).entries())); render(await listClientes(parsed)); } catch (error) { showFeedback(error instanceof Error ? error.message : 'No se pudieron cargar los clientes', true); } };
    filters?.addEventListener('submit', (event) => { event.preventDefault(); void load(); });
    document.querySelector('#new-client')?.addEventListener('click', () => { editingId = undefined; form?.reset(); const title = document.querySelector('#dialog-title'); if (title) title.textContent = 'Nuevo cliente'; dialog?.showModal(); });
    document.querySelector('#close-dialog')?.addEventListener('click', () => dialog?.close());
    function openEdit(client: Awaited<ReturnType<typeof listClientes>>[number]) { editingId = client.idCliente; Object.entries(client).forEach(([key, value]) => { const input = form?.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null; if (input && key !== 'fechaRegistro') input.value = String(value); }); const title = document.querySelector('#dialog-title'); if (title) title.textContent = 'Editar cliente'; dialog?.showModal(); }
    form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form || !formError) return; const value = Object.fromEntries(new FormData(form).entries()); delete value.idCliente; const parsed = clienteSchema.safeParse(value); if (!parsed.success) { formError.textContent = parsed.error.issues[0]?.message ?? 'Revisa los datos'; formError.classList.remove('hidden'); return; } try { if (editingId) await updateCliente(editingId, parsed.data); else await createCliente(parsed.data); dialog?.close(); showFeedback('Cliente guardado correctamente'); await load(); } catch (error) { formError.textContent = error instanceof Error ? error.message : 'No se pudo guardar'; formError.classList.remove('hidden'); } });
    document.querySelector('#logout')?.addEventListener('click', async () => { await logout().catch(() => undefined); window.location.assign('/login'); });
    function escapeHtml(value: string) { return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char] ?? char); }
    void load();
  </script>
</BaseLayout>
